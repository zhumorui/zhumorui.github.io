---
// Live visitor map (MapMyVisitors map widget), shown in the sidebar on desktop.
// Snippet source of truth: mapmyvisitors.com dashboard -> project "https://zhumorui.github.io/" -> Code.
const WIDGET_ID = "hFb-exuPxHUaoUI0sGozWFzO-WW9as0yt534gf4VhzI";
---

<div class="visitor-map mt-4 flex justify-center w-full max-lg:hidden">
  <script
    type="text/javascript"
    id="mapmyvisitors"
    src={`https://mapmyvisitors.com/map.js?d=${WIDGET_ID}&cl=ffffff&w=a`}
    is:inline
    defer
  ></script>
</div>

<style>
  .visitor-map {
    max-width: 200px;
    margin-left: auto;
    margin-right: auto;
  }
  .visitor-map :global(img),
  .visitor-map :global(canvas) {
    width: 100% !important;
    height: auto !important;
    max-width: 100%;
  }
</style>
